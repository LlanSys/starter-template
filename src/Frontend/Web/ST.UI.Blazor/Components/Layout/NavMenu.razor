@implements IAsyncDisposable
@inject TimeProvider Clock
@inject ILogger<NavMenu> Logger
@inject IAuthSession AuthSession
@inject IIamAdminService IamAdminService

<div class="side-shell">
    <div class="brand-row">
        <a class="brand-lockup" href="/dashboard" aria-label="StarterTemplate dashboard">
            <span class="brand-mark" aria-hidden="true">ST</span>
            <span class="brand-name">StarterTemplate</span>
        </a>
    </div>

    <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

    <div class="nav-scrollable">
        <nav class="nav flex-column">
            @if (_isLoading)
            {
                <div class="nav-loading">
                    <MudProgressLinear Color="Color.Success" Indeterminate="true" Class="my-2" Style="opacity: 0.4;" />
                </div>
            }
            else if (_loadError is not null)
            {
                <div class="nav-error" style="padding: 0.75rem 1rem; color: var(--st-muted); font-size: 0.8rem;">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Class="me-1" />
                    @_loadError
                </div>
            }
            else
            {
                var previousSection = -1;
                @foreach (var menu in _menus.Where(menu => menu.Url != "/overview" && !IsPlatformChild(menu)).OrderBy(Section))
                {
                    @if (previousSection >= 0 && previousSection != Section(menu))
                    {
                        <div class="nav-separator" aria-hidden="true"></div>
                    }
                    previousSection = Section(menu);
                    <section class="nav-group">
                        @RenderMenu(menu)
                    </section>
                }
            }
        </nav>
    </div>
    <nav class="nav-bottom" aria-label="Resources">
        <AuthorizeView Policy="ControlPlane.Manage">
            <NavLink class="nav-link" href="/control-panel/demo"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Small" /><span>Demo workspace</span></NavLink>
        </AuthorizeView>
        @foreach (var menu in _menus.Where(menu => menu.Url == "/overview"))
        {
            @RenderMenu(menu)
        }
    </nav>
    <div class="nav-bottom-inset" aria-hidden="true"></div>
</div>

@code {
    private static int Section(MenuResponse menu) => menu.Url.Equals("/dashboard", StringComparison.OrdinalIgnoreCase) ? 0
        : menu.Url.StartsWith("/admin", StringComparison.OrdinalIgnoreCase) || menu.Url.Equals("/control-panel", StringComparison.OrdinalIgnoreCase) ? 2 : 1;
    private static bool IsPlatformChild(MenuResponse menu) => menu.Url.StartsWith("/control-panel/", StringComparison.OrdinalIgnoreCase);
    private readonly List<MenuResponse> _menus = [];
    private bool _isLoading = true;
    private string? _loadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await AuthSession.InitializeAsync();
        if (!AuthSession.IsAuthenticated)
        {
            _isLoading = false;
            StateHasChanged();
            return;
        }

        await ReloadNavigationAsync();
        _pollTask = PollPolicyAsync();
    }
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _pollTask;
    private async Task ReloadNavigationAsync()
    {
        var response = await IamAdminService.GetNavigationMenusAsync("Sidebar");
        _menus.Clear();
        if (response.IsSuccess && response.Data is not null) { _menus.AddRange(response.Data); _loadError = null; }
        else _loadError = "Navigation unavailable.";
        _isLoading = false;
        StateHasChanged();
    }
    private async Task PollPolicyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15), Clock);
        try
        {
            while(await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                try { await InvokeAsync(async () => { await AuthSession.RefreshAsync(); if (AuthSession.IsAuthenticated) await ReloadNavigationAsync(); else { _menus.Clear(); StateHasChanged(); } }); }
                catch (Exception ex) when (!_lifetime.IsCancellationRequested) { NavigationPolicyLogDefinitions.RefreshFailed(Logger, ex); }
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_lifetime.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_pollTask is not null) await _pollTask;
        _lifetime.Dispose();
    }

    private RenderFragment RenderMenu(MenuResponse menu) => builder =>
    {
        var sequence = 0;
        builder.OpenComponent<NavLink>(sequence++);
        builder.AddAttribute(sequence++, "class", "nav-link");
        builder.AddAttribute(sequence++, "href", menu.Url.TrimStart('/'));
        if (menu.Key.Equals("dashboard", StringComparison.OrdinalIgnoreCase))
        {
            builder.AddAttribute(sequence++, "Match", NavLinkMatch.All);
        }

        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(childBuilder =>
        {
            var childSequence = 0;
            childBuilder.OpenComponent<MudIcon>(childSequence++);
            childBuilder.AddAttribute(childSequence++, "Icon", MenuIconMapper.Resolve(menu.Icon));
            childBuilder.AddAttribute(childSequence++, "Size", Size.Small);
            childBuilder.CloseComponent();
            childBuilder.OpenElement(childSequence++, "span");
            childBuilder.AddContent(childSequence++, menu.Title);
            childBuilder.CloseElement();
        }));
        builder.CloseComponent();

        if (menu.Children is null || menu.Children.Count == 0)
        {
            return;
        }

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "nav-children");
        foreach (var child in menu.Children.Where(child => !IsPlatformChild(child)))
        {
            builder.AddContent(sequence++, RenderMenu(child));
        }
        builder.CloseElement();
    };
}
