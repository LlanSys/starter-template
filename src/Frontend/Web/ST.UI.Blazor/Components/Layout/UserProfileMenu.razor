@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@rendermode InteractiveServer
@implements IDisposable
@inject TimeProvider Clock
@inject IAuthSession AuthSession
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<UserProfileMenu> Logger
@inject ProtectedSessionStorage WorkspaceStorage

<div class="account-menu">
    @if (AuthSession.IsAuthenticated)
    {
        <MudMenu @ref="_menu"
                 Dense="true"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudButton OnClick="@context.ToggleAsync"
                           Variant="Variant.Text"
                           Class="account-trigger"
                           EndIcon="@Icons.Material.Filled.ExpandMore"
                           aria-label="Account Menu">
                    <MudAvatar Size="Size.Small">
                        @if (ProfilePictureSource is not null)
                        {
                            <MudImage Src="@ProfilePictureSource"
                                      Alt="" />
                        }
                        else
                        {
                            @Initials
                        }
                    </MudAvatar>
                    <span class="account-name">@DisplayName</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/profile"
                             Icon="@Icons.Material.Filled.PersonOutline"
                             OnClick="CloseMenuAsync">Profile</MudMenuItem>
                <MudMenuItem Href="/iam/security"
                             Icon="@Icons.Material.Filled.Security"
                             OnClick="CloseMenuAsync">Security</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                             OnClick="LogoutAsync">Sign Out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    }
    else
    {
        <a href="/iam/sign-in">@(_sessionRestoreFailed ? "Sign In Again" : "Sign In")</a>
    }
</div>
