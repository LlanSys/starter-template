@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ILogger<UserProfileMenu> Logger
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage WorkspaceStorage

<div class="account-menu">
    @if (AuthSession.IsAuthenticated)
    {
        <details>
            <summary aria-label="Account menu">
                <MudAvatar Size="Size.Small">
                    @if (ProfilePictureSource is not null)
                    {
                        <MudImage Src="@ProfilePictureSource" Alt="" />
                    }
                    else
                    {
                        @Initials
                    }
                </MudAvatar>
                <span class="account-name">@DisplayName</span>
                <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" />
            </summary>
            <div class="account-actions">
                <a href="/profile"><MudIcon Icon="@Icons.Material.Filled.PersonOutline" Size="Size.Small" />Profile</a>
                <a href="/iam/security"><MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" />Security</a>
                <button type="button" @onclick="LogoutAsync"><MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />Sign out</button>
            </div>
        </details>
    }
    else
    {
        <a href="/iam/sign-in">@(_sessionRestoreFailed ? "Sign in again" : "Sign in")</a>
    }
</div>

@code {
    private string DisplayName
    {
        get
        {
            var fullName = $"{AuthSession.CurrentUser?.FirstName} {AuthSession.CurrentUser?.LastName}".Trim();

            return string.IsNullOrWhiteSpace(fullName)
                ? AuthSession.CurrentUser?.Email ?? "Signed-in user"
                : fullName;
        }
    }

    private bool _sessionRestoreFailed;

    private string Initials
    {
        get
        {
            var first = AuthSession.CurrentUser?.FirstName;
            var last = AuthSession.CurrentUser?.LastName;

            if (!string.IsNullOrWhiteSpace(first) && !string.IsNullOrWhiteSpace(last))
            {
                return $"{first[0]}{last[0]}".ToUpperInvariant();
            }

            var email = AuthSession.CurrentUser?.Email;
            return string.IsNullOrWhiteSpace(email) ? "ST" : email[..1].ToUpperInvariant();
        }
    }

    private string? ProfilePictureSource => AuthSession.ProfilePictureDataUri;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await AuthSession.InitializeAsync().WaitAsync(TimeSpan.FromSeconds(8));
        }
        catch (TimeoutException ex)
        {
            _sessionRestoreFailed = true;
            UserProfileMenuLogDefinitions.LogSessionRestoreTimedOut(Logger, ex);
        }
        catch (Exception ex)
        {
            _sessionRestoreFailed = true;
            UserProfileMenuLogDefinitions.LogSessionRestoreFailed(Logger, ex);
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LogoutAsync()
    {
        var wasDemo = AuthSession.CurrentUser?.IsDemoWorkspace == true;
        await AuthService.LogoutAsync();
        if (wasDemo) await AuthService.LogoutAsync();
        await WorkspaceStorage.DeleteAsync("workspace.platform");
        Navigation.NavigateTo("/iam/sign-in", forceLoad: true);
    }
}
