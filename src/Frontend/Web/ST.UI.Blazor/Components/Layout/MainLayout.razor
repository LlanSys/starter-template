@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthSession AuthSession
@using ST.UI.Blazor.Features.ControlPlane.Auditing.Contracts
@using ST.SharedKernel.Dtos.Common

<MudProviderHost />

<div class="page app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="workspace">
        <header class="app-top-row px-4">
            <WorkspaceSwitcher />
            <UserProfileMenu />
        </header>

        <article class="content px-4">
            <RequireAuthenticated>
                <PresentationHost>
                    @Body
                </PresentationHost>
            </RequireAuthenticated>
        </article>
    </main>
</div>

<SessionLifecycle />

<div id="blazor-error-ui"
     data-nosnippet>
    An unhandled error has occurred.
    <a href="."
       class="reload">Reload</a>
</div>

@code {
    protected override void OnInitialized()
    {
        AuthSession.AuthenticationChanged += OnAuthenticationChanged;
    }

    private void OnAuthenticationChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthSession.AuthenticationChanged -= OnAuthenticationChanged;
    }

}
