@inject IDialogService DialogService
@attribute [Authorize(Policy = "Page:/admin/iam")]
@page "/admin/iam"

@rendermode InteractiveServer
@inject IAuthSession AuthSession

<PageTitle>Identity & Access | StarterTemplate</PageTitle>

<RequireAuthenticated>
    <section class="dashboard-page">
        <div class="mb-4">
            <MudButton Href="/admin"
                       Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Primary"
                       Class="px-0">Back To Admin Center</MudButton>
        </div>

        <MudPaper Class="poc-panel"
                  Elevation="0">
            <div class="panel-heading">
                <h2>Identity & Access</h2>
                <div class="d-flex align-center gap-3">
                    @if (ActiveTab == "roles" && AuthSession.HasPermission("roles.create"))
                    {
                        @if (AuthSession.HasPermission("roles.manage_permissions"))
                        {
                            <MudButton OnClick="ApplyTemplateAsync"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Rule">Apply Template</MudButton>
                        }
                        <MudButton Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenRoleCreateDialogAsync">Add Role</MudButton>
                    }
                    else if (ActiveTab == "permissions" && AuthSession.HasPermission("roles.manage_permissions"))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenPermissionCreateDialogAsync">Add Permission</MudButton>
                    }
                    else if (ActiveTab == "users" && AuthSession.HasPermission("users.create"))
                    {
                        <MudButton Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenUserCreateDialogAsync">Add User</MudButton>
                    }
                </div>
            </div>

            <MudTabs ActivePanelIndex="ActiveIndex"
                     ActivePanelIndexChanged="OnTabChanged"
                     Rounded="true"
                     Elevation="0"
                     Class="st-catalog-tabs">
                @foreach (var tab in VisibleTabs)
                {
                    <MudTabPanel Text="@tab.Title" />
                }
            </MudTabs>

            @if (ActiveTab == "roles")
            {
                <AdminRoles @key="_roleRevision"
                            @ref="_rolesTab" />
            }
            else if (ActiveTab == "permissions")
            {
                <AdminPermissions @ref="_permissionsTab" />
            }
            else if (ActiveTab == "users")
            {
                <AdminUsers @ref="_usersTab" />
            }
            else if (ActiveTab == "devices")
            {
                <AdminUserDevices />
            }
        </MudPaper>
    </section>
</RequireAuthenticated>
