@page "/admin"
@attribute [Authorize(Policy = "Page:/admin")]

@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IIamAdminService IamAdminService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Admin Center | StarterTemplate</PageTitle>

<RequireAuthenticated>
    <section class="dashboard-page">
        @if (!_isReady)
        {
            <MudPaper Class="status-card"
                      Elevation="0">Loading admin workspace...</MudPaper>
        }
        else
        {
            <div class="panel-heading"><h1 class="platform-page-title">Admin Center</h1></div>
            <MudText Class="mb-4">Manage navigation, organization settings, identity, access and support for this workspace.</MudText>
            @if (_modules.Count == 0)
            {
                <MudText Typo="Typo.body2">No administration options are available for your account.</MudText>
            }
            else
            {
                <div class="control-panel-grid">
                    @foreach (var item in _modules)
                    {
                        <a class="control-panel-tile" href="@item.Url">
                            <MudIcon Icon="@MenuIconMapper.Resolve(item.Icon)" Size="Size.Small" />
                            <span>@MenuTitle(item)</span>
                        </a>
                    }
                </div>
            }
        }
    </section>
</RequireAuthenticated>
