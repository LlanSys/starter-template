@page "/control-panel"
@layout ControlPlaneLayout
@attribute [Authorize(Policy = "ControlPlane.Access")]
@inject NavigationManager Navigation
@inject IAuthSession AuthSession

<PageTitle>Control Panel | StarterTemplate</PageTitle>
<section class="dashboard-page">
    <div class="panel-heading"><h1 class="platform-page-title">Control Panel</h1></div>
    <MudText Class="mb-4">Manage customer onboarding, deployment stamps, modules, and platform operations.</MudText>
    <div class="control-panel-grid">
        @foreach (var tile in Tiles.Where(tile => AuthSession.HasPermission(tile.Permission)))
        {
            <a class="control-panel-tile" href="@tile.Url">
                <MudIcon Icon="@tile.Icon" Size="Size.Small" />
                <span>@tile.Title</span>
            </a>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private static readonly (string Title, string Url, string Icon, string Permission)[] Tiles =
    [
        ("Platform Staff", "/control-panel/staff", Icons.Material.Filled.Badge, PlatformPermissions.ViewPlatformStaff),
        ("Deployment Stamps", "/control-panel/stamps", Icons.Material.Filled.Dns, PlatformPermissions.ViewStamps),
        ("Tenants", "/control-panel/tenants", Icons.Material.Filled.Business, PlatformPermissions.ViewTenants),
        ("Modules", "/control-panel/modules", Icons.Material.Filled.Apps, PlatformPermissions.ViewModules),
        ("KYC Cases", "/control-panel/kyc", Icons.Material.Filled.FactCheck, PlatformPermissions.ViewKyc),
        ("Navigation", "/admin/menus", Icons.Material.Filled.Menu, "menus.view"),
        ("Identity & Access", "/admin/iam", Icons.Material.Filled.Security, "roles.view"),
        ("Access Catalog", "/admin/access-catalog", Icons.Material.Filled.List, "menus.view"),
        ("KYC Retention Policy", "/control-panel/kyc/retention", Icons.Material.Filled.Policy, PlatformPermissions.ViewKyc),
        ("Managed Support", "/control-panel/support", Icons.Material.Filled.SupportAgent, PlatformPermissions.ViewSupport),
        ("Audit History", "/control-panel/impersonation", Icons.Material.Filled.History, PlatformPermissions.ViewAudit),
        ("Demo Workspace", "/control-panel/demo", Icons.Material.Filled.Preview, PlatformPermissions.EnterDemo)
    ];

    protected override void OnParametersSet()
    {
        // Preserve shared bookmarks from the former tabbed landing page.
        var destination = Tab?.ToLowerInvariant() switch
        {
            "stamps" => "/control-panel/stamps",
            "tenants" => "/control-panel/tenants",
            "modules" => "/control-panel/modules",
            "kyc" => "/control-panel/kyc",
            _ => null
        };
        if (destination is not null)
        {
            Navigation.NavigateTo(destination, replace: true);
        }
    }
}
