@page "/control-panel"
@layout ControlPlaneLayout
@attribute [Authorize(Policy = "ControlPlane.Manage")]
@using ST.UI.Blazor.Features.ControlPlane.Modules.Pages
@inject NavigationManager Navigation
<PageTitle>Control Panel | StarterTemplate</PageTitle>
<h1 class="platform-page-title mb-4">Control Panel</h1>
<MudTabs ActivePanelIndex="_index" ActivePanelIndexChanged="SelectTab" Elevation="0" Rounded="false" PanelClass="pt-4" KeepPanelsAlive="false">
    <MudTabPanel Text="Deployment Stamps"><AdminDeploymentStamps Embedded="true" /></MudTabPanel>
    <MudTabPanel Text="Tenants"><AdminTenants Embedded="true" /></MudTabPanel>
    <MudTabPanel Text="Modules"><Modules Embedded="true" /></MudTabPanel>
</MudTabs>
@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private int _index;
    protected override void OnParametersSet() => _index = Tab switch { "tenants" => 1, "modules" => 2, _ => 0 };
    private void SelectTab(int index)
    {
        _index = index;
        Navigation.NavigateTo("/control-panel?tab=" + (index switch { 1 => "tenants", 2 => "modules", _ => "stamps" }), replace: true);
    }
}
