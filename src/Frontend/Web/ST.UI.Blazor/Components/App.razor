<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="utf-8" />
        <meta name="viewport"
              content="width=device-width, initial-scale=1.0" />
        <base href="/" />
        <ResourcePreloader />
        <link rel="stylesheet"
              href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
        <link rel="stylesheet"
              href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
        <link rel="stylesheet"
              href="@Assets["css/app.css"]" />
        <link rel="stylesheet"
              href="@Assets["ST.UI.Blazor.styles.css"]" />
        <ImportMap />
        <link rel="icon"
              type="image/png"
              href="favicon.png" />
        <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    </head>

    <body>
        <div id="app-startup">
            <AuthLoadingScreen />
        </div>
        <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
        <ReconnectModal />
        @* Must run before blazor.web.js: it holds clicks made before the interactive router is ready. *@
        <script src="@Assets["js/appStartup.js"]"></script>
        <script src="@Assets["_framework/blazor.web.js"]"></script>
        <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
        <script src="@Assets["js/webauthn.js"]"></script>
    </body>

</html>
