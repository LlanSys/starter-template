@inject IOrgSettingsService OrgSettingsService

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2"
                 Class="mb-3">@Setting.Definition.Description</MudText>
        <MudAutocomplete T="string"
                         Label="@Setting.Definition.Label"
                         @bind-Value="_value"
                         SearchFunc="SearchAsync"
                         ToStringFunc="Label"
                         CoerceText="true"
                         CoerceValue="false"
                         Strict="true"
                         MaxItems="100"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Disabled="_busy" />
        <MudText Typo="Typo.caption"
                 Class="mt-2">Default: @Label(Setting.Definition.DefaultValue)</MudText>
        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Error"
                      Dense="true"
                      Class="mt-3">@_message</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Disabled="_busy">Cancel</MudButton>
        <MudButton OnClick="SaveAsync"
                   Color="Color.Success"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Save"
                   Disabled="@(_busy || !OrganizationSettingCatalog.IsValid(Setting.Definition.Key, _value))">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public CatalogOrgSettingResponse Setting { get; set; } = default!;
    private string _value = "";
    private bool _busy;
    private string? _message;

    protected override void OnInitialized() { _value = Setting.Value; }
    private void Cancel() { MudDialog.Cancel(); }
    private string Label(string? value) { return Setting.Definition.Options.FirstOrDefault(option => option.Value == value)?.Label ?? value ?? ""; }
    private Task<IEnumerable<string>> SearchAsync(string text, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        return Task.FromResult(Setting.Definition.Options.Where(option => string.IsNullOrWhiteSpace(text)
            || option.Label.Contains(text, StringComparison.OrdinalIgnoreCase) || option.Value.Contains(text, StringComparison.OrdinalIgnoreCase))
            .Select(option => option.Value));
    }
    private async Task SaveAsync()
    {
        _busy = true;
        var response = await OrgSettingsService.SaveAsync(Setting.Definition.Key,
            new SaveCatalogOrgSettingRequest(_value, Setting.Revision));
        _busy = false;
        if (response.IsSuccess) { MudDialog.Close(DialogResult.Ok(true)); }
        else { _message = UserMessageSanitizer.Normalize(response.Message, "Could not save this setting."); }
    }
}
