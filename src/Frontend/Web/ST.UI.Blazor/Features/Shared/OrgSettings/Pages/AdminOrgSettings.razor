@page "/admin/org-settings"
@attribute [Authorize(Policy = "Page:/admin/org-settings")]
@inject IAuthSession AuthSession
@inject IOrgSettingsService OrgSettingsService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimeProvider Clock

<PageTitle>Organization Settings</PageTitle>
<section class="dashboard-page">
    <MudButton Href="/admin"
               Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Class="px-0 mb-4">Back To Admin Center</MudButton>
    <MudPaper Class="poc-panel"
              Elevation="0">
        <div class="panel-heading">
            <h2>Organization Settings</h2>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadAsync"
                           Disabled="_loading"
                           title="Refresh" />
        </div>
        <MudText Typo="Typo.body2"
                 Class="mb-3">Workspace defaults for dates, times, numbers and lists. Reset a setting to use its supplied default.</MudText>
        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Warning"
                      Dense="true"
                      Class="mb-3">@_message</MudAlert>
        }
        <div class="st-table-scroll">
            <MudTable Items="_settings"
                      Dense="true"
                      Elevation="0"
                      Loading="_loading"
                      Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh>Setting</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Default</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh Class="st-actions-column">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <strong>@context.Definition.Label</strong>
                        <MudText Typo="Typo.caption"
                                 Class="d-block">@context.Definition.Description</MudText>
                    </MudTd>
                    <MudTd>@Label(context, context.Value)</MudTd>
                    <MudTd>@Label(context, context.Definition.DefaultValue)</MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Text"
                                 Color="Color.Default">@(context.IsOverridden ? "Workspace" : "Default")</MudChip>
                    </MudTd>
                    <MudTd Class="st-actions-column">
                        <TableRowActions CanView="false"
                                         CanDelete="false"
                                         CanEdit="@AuthSession.HasPermission("tenant-settings.update")"
                                         OnEdit="@(() => EditAsync(context))"
                                         ExtraActions="@(context.IsOverridden && AuthSession.HasPermission("tenant-settings.delete") ? new[] {  "Reset To Default" }  : Array.Empty<string>())"
                                         OnExtraAction="@(_ => ResetAsync(context))" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="pa-3">No settings available.</MudText>
                </NoRecordsContent>
            </MudTable>
        </div>
        @if (_settings.Count > 0)
        {
            <MudPaper Outlined="true"
                      Class="pa-4 mt-4"
                      Elevation="0">
                <MudText Typo="Typo.subtitle2">Display Preview · @Presentation.TimeZoneLabel</MudText>
                <MudText Typo="Typo.body2">Timestamp: @Presentation.Format(_previewInstant)</MudText>
                <MudText Typo="Typo.body2">Calendar Date: @Presentation.FormatDate(DateOnly.FromDateTime(_previewInstant.UtcDateTime))</MudText>
                <MudText Typo="Typo.body2">Number: @Presentation.Number(1234567.89m)</MudText>
            </MudPaper>
            <details class="mt-4"><summary>Recent Changes</summary>
                <MudText Typo="Typo.caption">Latest 100 changes in this workspace. Times shown in @Presentation.TimeZoneLabel.</MudText>
                <MudTable Items="_history"
                          Dense="true"
                          Elevation="0"
                          HorizontalScrollbar="true"
                          RowsPerPage="Presentation.PageSize">
                    <HeaderContent>
                        <MudTh>When</MudTh>
                        <MudTh>Setting</MudTh>
                        <MudTh>Previous Override</MudTh>
                        <MudTh>New Override</MudTh>
                        <MudTh>Changed By</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@Presentation.Format(context.At)</MudTd>
                        <MudTd>@(OrganizationSettingCatalog.Find(context.Key)?.Label ?? context.Key)</MudTd>
                        <MudTd>@(context.PreviousValue ?? "Default")</MudTd>
                        <MudTd>@(context.Reset ? "Reset To Default" : context.Value)</MudTd>
                        <MudTd>@context.ActorId</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>No changes recorded.</NoRecordsContent>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </details>
        }
    </MudPaper>
</section>
