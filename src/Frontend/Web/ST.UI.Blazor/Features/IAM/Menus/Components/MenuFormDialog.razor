@using ST.SharedKernel.Features.ControlPlane.Modules.Dtos
@using ST.UI.Blazor.Features.Shared.BackendApi.Contracts.Interfaces
@inject IBackendApiClient Api
@inject IIamAdminService IamAdminService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
    <EditForm FormName="iam-menu-form" Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_model.Title" Label="Title" Margin="Margin.Dense" Variant="Variant.Outlined" Required />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Value="_model.Placement" ValueChanged="OnPlacementChanged" Label="Show in" Margin="Margin.Dense" Variant="Variant.Outlined" Required>
                        @foreach (var placement in _referenceData.MenuPlacements)
                        {
                            <MudSelectItem Value="@placement.Key">@placement.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="_model.ParentId" Label="Parent" Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" ToStringFunc="ParentLabel">
                        @foreach (var menu in ParentOptions)
                        {
                            <MudSelectItem T="Guid?" Value="@menu.Id">@menu.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="string" Value="_model.Url" ValueChanged="OnPageSelected" ReadOnly="@(ExistingMenu?.CatalogueKey is not null)" Label="Page" SearchFunc="SearchPagesAsync"
                                     ToStringFunc="PageLabel" MinCharacters="0" MaxItems="30" Clearable="true"
                                     Strict="true" CoerceValue="false" Margin="Margin.Dense" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudAutocomplete T="string" @bind-Value="_model.Icon" Label="Search icons"
                                     SearchFunc="MenuIconMapper.SearchAsync" Margin="Margin.Dense" Variant="Variant.Outlined"
                                     MinCharacters="0" MaxItems="50" Strict="true" CoerceValue="false">
                        <ItemTemplate Context="iconKey">
                            <MudIcon Icon="@MenuIconMapper.Resolve(iconKey)" Size="Size.Small" Class="me-2" />@iconKey
                        </ItemTemplate>
                        <MoreItemsTemplate><MudText Typo="Typo.caption" Class="pa-2">Refine the name or style to see more icons.</MudText></MoreItemsTemplate>
                    </MudAutocomplete>
                </MudItem>
                <MudItem xs="12" sm="6"><MudTextField Value="@ModuleLabel(_model.RequiredModule)" Label="Module" ReadOnly="true" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12" sm="6"><MudNumericField T="int" @bind-Value="_model.DisplayOrder" Label="Position" Min="0" Max="10000" Margin="Margin.Dense" Variant="Variant.Outlined" /></MudItem>
                <MudItem xs="12"><MudText Typo="Typo.subtitle2">Visibility</MudText></MudItem>
                <MudItem xs="12" sm="6">
                    <MenuAccessPicker Label="Roles" Options="_roles" @bind-Values="_model.RequiredRoleNames" Disabled="_isSaving" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MenuAccessPicker Label="Permissions" Options="_permissionKeys" @bind-Values="_model.RequiredPermissionKeys" Disabled="_isSaving" />
                </MudItem>
                <MudItem xs="12"><MudText Typo="Typo.caption">Any selected role and all selected permissions must match.</MudText></MudItem>
                @if (ExistingMenu is not null)
                {
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_model.IsActive" Color="Color.Success" Label="Active" />
                    </MudItem>
                }
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Success" Disabled="@(_isSaving || !_cataloguesLoaded)" OnClick="SaveAsync">@(_isSaving ? "Saving..." : SaveLabel)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private IReadOnlyList<CatalogueEntryResponse> _pages = [];
    private IReadOnlyList<string> _permissionKeys = [];
    private IReadOnlyList<string> _roles = [];
    private bool _cataloguesLoaded;

    private IamReferenceDataResponse _referenceData = new([], [], [], [], [], []);
    private MenuFormModel _model = new();
    private bool _isSaving;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public MenuResponse? ExistingMenu { get; set; }

    [Parameter]
    public IReadOnlyList<MenuResponse> Menus { get; set; } = [];

    private static string ModuleLabel(string? module) => module?.ToLowerInvariant() switch { "iam" => "Identity and access", "core" => "Core workspace", "payments" => "Payments", "showcase" => "Showcase", _ => module ?? "" };
    private string SaveLabel => ExistingMenu is null ? "Create" : "Update";


    private IReadOnlyList<MenuResponse> ParentOptions =>
        [.. Menus.Where(menu =>
                (ExistingMenu is null || menu.Id != ExistingMenu.Id)
                && menu.Placement.Equals(_model.Placement, StringComparison.OrdinalIgnoreCase))
            .OrderBy(menu => menu.Title)];

    private IReadOnlyList<CatalogOptionResponse> RouteOptions =>
        [.. _referenceData.MenuRoutes
            .DistinctBy(route => route.Key)
            .OrderBy(static route => route.Label)];

    protected override async Task OnInitializedAsync()
    {
        _model = ExistingMenu is null ? new MenuFormModel() : MenuFormModel.From(ExistingMenu);
        await LoadReferenceDataAsync();

        await LoadPermissionsAsync();
    }

    private async Task LoadReferenceDataAsync()
    {
        var response = await IamAdminService.GetReferenceDataAsync();
        if (!response.IsSuccess || response.Data is null)
        {
            Snackbar.Add(response.Message ?? "We could not load IAM reference data.", Severity.Warning);
            return;
        }

        _referenceData = response.Data;
        var available = await Api.SendAsync<IReadOnlyList<CatalogueEntryResponse>>(HttpMethod.Get, "api/v1/modules/available");
        _pages = available.Data?.Where(x => x.Kind == "Page" && x.IsImplemented && x.IsActive).ToArray() ?? [];
    }

    private async Task LoadPermissionsAsync()
    {
        var roles = await IamAdminService.GetRolesAsync();
        if (!roles.IsSuccess || roles.Data is null)
        {
            Snackbar.Add(UserMessageSanitizer.Normalize(roles.Message, "Could not load roles."), Severity.Warning);
            return;
        }
        _roles = roles.Data.Select(role => role.Name).Order(StringComparer.OrdinalIgnoreCase).ToArray();
        var permissions = new List<string>();
        Guid? cursor = null;
        do
        {
            var response = await IamAdminService.SearchPermissionsAsync(new PermissionSearchRequest(IsActive: true, PageSize: 100, Cursor: cursor));
            if (!response.IsSuccess || response.Data is null)
            {
                Snackbar.Add(UserMessageSanitizer.Normalize(response.Message, "Could not load permissions."), Severity.Warning);
                return;
            }
            permissions.AddRange(response.Data.Items.Select(permission => permission.Key));
            Guid? next = response.Data.HasNextPage ? response.Data.NextCursor : null;
            if (next is null || next == cursor) break;
            cursor = next;
        } while (true);
        _permissionKeys = permissions.Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase).ToArray();
        _cataloguesLoaded = true;
    }

    private void OnPageSelected(string? path)
    {
        _model.Url = path ?? "";
        var page = _pages.Where(x => x.Path == path).OrderBy(x => x.Placement == "Sidebar" ? 0 : 1).FirstOrDefault();
        if (page is null) return;
        _model.RequiredModule = page.ModuleKey; _model.Title = page.Title; _model.Icon = page.Icon;
        _model.Placement = page.Placement; _model.DisplayOrder = page.DisplayOrder;
        _model.ParentId = page.ParentKey is { Length: > 0 } parentKey ? Menus.FirstOrDefault(x => x.CatalogueKey == parentKey || x.Key == parentKey)?.Id : null;
        _model.RequiredPermissionKeys = page.PermissionKeys; _model.RequiredRoleNames = page.RoleNames;
    }
    private string PageLabel(string? url) => RouteOptions.FirstOrDefault(route => string.Equals(route.Key, url, StringComparison.OrdinalIgnoreCase))?.Label ?? url ?? string.Empty;
    private Task<IEnumerable<string>> SearchPagesAsync(string? text, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        return Task.FromResult(RouteOptions.Where(route => string.IsNullOrWhiteSpace(text) || route.Label.Contains(text, StringComparison.OrdinalIgnoreCase)).Select(route => route.Key));
    }

    private async Task SaveAsync()
    {
        if (!_cataloguesLoaded || _isSaving) return;
        if (string.IsNullOrWhiteSpace(_model.Title) || string.IsNullOrWhiteSpace(_model.Placement))
        {
            Snackbar.Add("Menu title and placement are required.", Severity.Warning);
            return;
        }

        _isSaving = true;
        var response = ExistingMenu is null
            ? await IamAdminService.CreateMenuAsync(_model.ToCreateRequest())
            : await IamAdminService.UpdateMenuAsync(_model.Id, _model.ToUpdateRequest());
        _isSaving = false;

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Menu save failed.", Severity.Error);
            return;
        }

        Snackbar.Add(ExistingMenu is null ? "Menu created." : "Menu updated.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(response.Data));
    }

    private void Cancel() => MudDialog.Cancel();

    private void OnPlacementChanged(string placement)
    {
        _model.Placement = placement;
        _model.ParentId = null;
        if (!RouteOptions.Any(route => string.Equals(route.Key, _model.Url, StringComparison.OrdinalIgnoreCase)))
        {
            _model.Url = string.Empty;
        }
    }

    private string ParentLabel(Guid? parentId)
    {
        if (!parentId.HasValue || parentId.Value == Guid.Empty)
        {
            return string.Empty;
        }

        return Menus.FirstOrDefault(menu => menu.Id == parentId.Value)?.Title ?? "Current parent";
    }

    private sealed class MenuFormModel
    {
        public Guid Id { get; set; }
        public int ExpectedVersion { get; set; }
        public int DisplayOrder { get; set; }
        public Guid? ParentId { get; set; }

        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string Icon { get; set; } = "Menu";
        public string Placement { get; set; } = "AdminCenter";
        public IReadOnlyList<string> RequiredRoleNames { get; set; } = [];
        public IReadOnlyList<string> RequiredPermissionKeys { get; set; } = [];
        public string? RequiredModule { get; set; }
        public bool IsActive { get; set; } = true;

        public static MenuFormModel From(MenuResponse menu)
            => new()
            {
                Id = menu.Id,
                ExpectedVersion = menu.OverrideVersion,
                DisplayOrder = menu.DisplayOrder,
                ParentId = menu.ParentId,

                Title = menu.Title,
                Description = menu.Description,
                Url = menu.Url,
                Icon = menu.Icon,
                Placement = menu.Placement,
                RequiredRoleNames = menu.RequiredRoleNames,
                RequiredPermissionKeys = menu.RequiredPermissionKeys.Concat(string.IsNullOrWhiteSpace(menu.RequiredPermissionKey) ? [] : new[] { menu.RequiredPermissionKey! }).Distinct(StringComparer.OrdinalIgnoreCase).ToArray(),
                RequiredModule = menu.RequiredModule,
                IsActive = menu.IsActive
            };

        public CreateMenuRequest ToCreateRequest()
            => new()
            {
                ParentId = ParentId,
                DisplayOrder = DisplayOrder,

                Title = Title,
                Description = Description,
                Url = Url,
                Icon = Icon,
                Placement = Placement,
                RequiredRoleNames = RequiredRoleNames,
                RequiredPermissionKeys = RequiredPermissionKeys,
                RequiredModule = RequiredModule
            };

        public UpdateMenuRequest ToUpdateRequest()
            => new()
            {
                Id = Id,
                ExpectedVersion = ExpectedVersion,
                ParentId = ParentId,
                DisplayOrder = DisplayOrder,

                Title = Title,
                Description = Description,
                Url = Url,
                Icon = Icon,
                Placement = Placement,
                RequiredRoleNames = RequiredRoleNames,
                RequiredPermissionKeys = RequiredPermissionKeys,
                RequiredModule = RequiredModule,
                IsActive = IsActive
            };
    }
}
