@inject IIamAdminService IamAdminService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Role name" Margin="Margin.Dense" Variant="Variant.Outlined" Required />
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="@(ExistingRole is null ? Color.Primary : Color.Success)" Disabled="_isSaving" OnClick="SaveAsync">@(_isSaving ? "Saving..." : ExistingRole is null ? "Create" : "Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {

    private string _name = string.Empty;

    private bool _isSaving;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AdminRoleListResponse? ExistingRole { get; set; }

    protected override void OnInitialized()
    {
        _name = ExistingRole?.Name ?? string.Empty;


    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Role name is required.", Severity.Warning);
            return;
        }

        _isSaving = true;
        var response = ExistingRole is null
            ? await IamAdminService.CreateRoleAsync(new CreateRoleRequest(_name.Trim()))
            : await IamAdminService.UpdateRoleAsync(ExistingRole.Id, new UpdateRoleRequest(_name.Trim()));
        _isSaving = false;

        if (!response.IsSuccess)
        {
            Snackbar.Add(response.Message ?? "Role creation failed.", Severity.Error);
            return;
        }

        Snackbar.Add(ExistingRole is null ? "Role created." : "Role updated.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(response.Data));
    }

    private void Cancel() => MudDialog.Cancel();
}
