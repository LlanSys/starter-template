@using ST.UI.Blazor.Features.IAM.Users.Implementations
@inject WorkspaceSelection WorkspaceSelection
@page "/profile"
@attribute [Authorize]
@implements IDisposable
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Profile | StarterTemplate</PageTitle>
<section class="profile-page"
         aria-label="Profile">
    @if (!_isReady)
    {
        <MudProgressLinear Indeterminate="true"
                           aria-label="Loading profile" />
    }
    else if (AuthSession.CurrentUser is { } user)
    {
        <MudPaper Class="poc-panel profile-overview"
                  Elevation="0">
            <div class="profile-identity">
                <MudAvatar Size="Size.Large"
                           Class="profile-avatar-large">
                    @if (ProfilePictureSource is not null)
                    {
                        <MudImage Src="@ProfilePictureSource"
                                  Alt=""
                                  ObjectFit="ObjectFit.Cover" />
                    }
                    else
                    {
                        @Initials
                    }
                </MudAvatar>
                <div class="profile-identity-copy">
                    <span class="eyebrow">My Profile</span>
                    <h1>@DisplayName</h1>
                    <p class="profile-email"
                       title="@user.Email">@user.Email</p>
                    <div class="profile-badges">
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Text"
                                 Size="Size.Small">Signed In</MudChip>
                        <MudChip T="string"
                                 Color="@(user.EmailConfirmed ? Color.Success : Color.Warning)"
                                 Variant="Variant.Text"
                                 Size="Size.Small">@(user.EmailConfirmed ? "Email Verified" : "Email Not Verified")</MudChip>
                    </div>
                </div>
            </div>
            <MudButton Href="/iam/security"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Security"
                       Size="Size.Small">Security Settings</MudButton>
            <div class="profile-upload-control">
                <label class="profile-upload-button"
                       for="profile-photo"
                       aria-disabled="@_isUploading">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoCamera"
                             Size="Size.Small" />
                    @(_isUploading ? "Uploading…" : "Change Photo")
                </label>
                <InputFile id="profile-photo"
                           class="visually-hidden"
                           aria-label="Change Photo"
                           aria-describedby="profile-photo-help"
                           OnChange="OnProfilePictureSelectedAsync"
                           accept="image/jpeg,image/png,image/webp"
                           disabled="@_isUploading" />
                <small id="profile-photo-help">JPEG, PNG, or WebP up to 10 MB.</small>
            </div>
            @if (_isUploading)
            {
                <MudProgressLinear Indeterminate="true"
                                   aria-label="Uploading profile photo" />
            }
        </MudPaper>
        <MudPaper Class="poc-panel profile-details"
                  Elevation="0">
            <div class="panel-heading">
                <h2>Account Details</h2>
            </div>
            <dl class="profile-details-grid">
                <div>
                    <dt>Username</dt>
                    <dd>@user.UserName</dd>
                </div>
                <div>
                    <dt>Organization</dt>
                    <dd>@(user.WorkspaceName ?? (WorkspaceSelection.Current is { } selected && selected.TenantId == user.TenantId ? OrganizationBranding.DisplayName(selected.Name, selected.IsPlatformWorkspace) : "Organization"))</dd>
                </div>
                <div>
                    <dt>Email</dt>
                    <dd>@user.Email</dd>
                </div>
                <div>
                    <dt>Roles</dt>
                    <dd>@(user.Roles.Count > 0 ? string.Join(", ", user.Roles) : "No Roles Assigned")</dd>
                </div>
                <div>
                    <dt>Authenticator MFA</dt>
                    <dd>
                        <MudChip T="string"
                                 Variant="Variant.Text"
                                 Color="@(user.TwoFactorEnabled ? Color.Success : Color.Warning)"
                                 Size="Size.Small">@(user.TwoFactorEnabled ? "Enabled" : "Not Enabled")</MudChip>
                    </dd>
                </div>
                <div>
                    <dt>Last Sign-In (@Presentation.TimeZoneLabel)</dt>
                    <dd>@(user.LastLoginAt.HasValue ? Presentation.Format(user.LastLoginAt) : "Current Session")</dd>
                </div>
            </dl>
        </MudPaper>
    }
</section>
