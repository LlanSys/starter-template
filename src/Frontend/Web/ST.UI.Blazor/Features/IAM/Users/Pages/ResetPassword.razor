@using ST.UI.Blazor.Features.IAM.Users.Implementations
@using ST.UI.Blazor.Features.IAM.Users.State
@using ST.UI.Blazor.Features.Shared.BackendApi.Contracts.Interfaces
@page "/iam/reset-password"
@layout AuthLayout
@rendermode InteractiveServer
@inject IAuthService AuthService
@inject PasswordRecoveryState RecoveryState
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject WorkspaceSelection WorkspaceSelection
@inject IBackendApiClient ApiClient

<PageTitle>Reset password | StarterTemplate</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-heading"><h1>Reset password</h1></div>
        @if (string.IsNullOrWhiteSpace(Email))
        {
            <div class="form-stack">
                <div class="alert alert-danger" role="alert">This password-reset request is invalid. Start a new recovery request.</div>
                <a class="btn btn-st-primary btn-lg" href="/iam/forgot-password">Start recovery</a>
            </div>
        }
        else
        {
            <EditForm FormName="iam-reset-password" Model="_formModel" OnValidSubmit="ResetAsync">
                <DataAnnotationsValidator />
                <div class="form-stack">
                    <div>
                        <label for="new-password">New password</label>
                        <InputText id="new-password" type="password" class="form-control form-control-lg" @bind-Value="_formModel.NewPassword" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _formModel.NewPassword)" />
                    </div>
                    <div>
                        <label for="confirm-password">Confirm password</label>
                        <InputText id="confirm-password" type="password" class="form-control form-control-lg" @bind-Value="_formModel.ConfirmPassword" autocomplete="new-password" />
                        <ValidationMessage For="@(() => _formModel.ConfirmPassword)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert alert-danger" role="alert">@_message</div>
                    }

                    <button class="btn btn-st-primary btn-lg" type="submit" disabled="@_isBusy">
                        @(_isBusy ? "Updating..." : "Update password")
                    </button>
                </div>
            </EditForm>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name="tenantId")] public Guid? TenantId {get;set;}
    protected override async Task OnAfterRenderAsync(bool first) {
      if(!first || TenantId is null)return;
      var selected=await WorkspaceSelection.GetAsync();if(selected?.TenantId==TenantId)return;
      var response=await ApiClient.SendAsync<WorkspaceInfoResponse>(HttpMethod.Get,$"api/v1/workspaces/resolve?tenantId={TenantId}",requiresAuthentication:false);
      if(!response.IsSuccess || response.Data is null) {_message="This workspace is not available.";StateHasChanged();return;}
      await WorkspaceSelection.SetAsync(new(response.Data.TenantId,response.Data.Identifier,response.Data.Name));Navigation.NavigateTo(Navigation.Uri,forceLoad:true);
    }
    private readonly ResetPasswordFormModel _formModel = new();
    private bool _isBusy;
    private string? _message;

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    protected override void OnInitialized()
    {
        if ((string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token)) &&
            RecoveryState.TryConsume(out var email, out var transitionToken))
        {
            Email = email;
            Token = transitionToken;
        }
    }

    private async Task ResetAsync()
    {
        _isBusy = true;
        _message = null;

        var request = new ResetPasswordRequest(
            Email!.Trim(),
            _formModel.NewPassword,
            null,
            _formModel.ConfirmPassword,
            Token);
        var response = await AuthService.ResetPasswordAsync(request).ConfigureAwait(true);

        _isBusy = false;
        if (!response.IsSuccess || response.Data != true)
        {
            _message = UserMessageSanitizer.Normalize(response.Message, "Your password could not be reset. Request a new recovery code or link and try again.");
            return;
        }

        Snackbar.Add("Password updated. You can now sign in.", Severity.Success);
        Navigation.NavigateTo("/iam/sign-in");
    }
}
