@inject FrontendTenantContext Frontend
@using ST.SharedKernel.Features.ControlPlane.Tenants.Dtos
@using ST.SharedKernel.Features.IAM.Users.Dtos
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using ST.UI.Blazor.Features.ControlPlane.Demo
@using ST.UI.Blazor.Features.IAM.Users.Implementations
@using ST.UI.Blazor.Features.Shared.BackendApi.Contracts.Interfaces
@using System.Text.Json
@inject WorkspaceSelection WorkspaceSelection
@inject IBackendApiClient Api
@inject TimeProvider Clock
@page "/"
@page "/iam/sign-in"
@layout AuthLayout
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject NavigationManager Navigation
@inject ILogger<SignIn> Logger
@inject ISnackbar Snackbar
@inject IOptions<BackendApiSettings> BackendApiSettings
@inject IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject ProtectedSessionStorage SessionStorage
@inject ITokenStorage Tokens
@implements IAsyncDisposable

<PageTitle>@(_ready && _selectedWorkspace is not null ? "Sign In | " + OrganizationBranding.DisplayName(_selectedWorkspace.Name, _selectedWorkspace.IsPlatformWorkspace) : "Sign In")</PageTitle>

<section class="auth-shell">
    <div class="auth-card sign-in-card">
        <AuthBrand OrganizationName="@(_changingWorkspace ? null : _selectedWorkspace?.Name)"
                   IsPlatformWorkspace="@(_selectedWorkspace?.IsPlatformWorkspace == true)"
                   TenantId="@_selectedWorkspace?.TenantId"
                   UseSelectedOrganization="false"
                   Loading="@(!_ready)" />
        <div class="auth-heading">
            <h1>Sign in</h1>
            @if (_ready && !Frontend.IsBound && !_changingWorkspace && _selectedWorkspace is not null)
            {
                <MudButton OnClick="ChangeWorkspaceAsync"
                           Size="Size.Small"
                           Variant="Variant.Text"
                           Disabled="_isBusy">Change Organization</MudButton>
            }
        </div>
        @if (!_ready)
        {
            <div class="auth-loading"
                 role="status"
                 aria-live="polite">
                <span class="auth-loading-spinner"
                      aria-hidden="true"></span>
                <p>Preparing sign-in…</p>
            </div>
        }
        else if (_hostLinkConflict)
        {
            <p role="alert">This sign-in link belongs to another organization.</p>
            <MudButton Href="/iam/sign-in"
                       Variant="Variant.Filled"
                       Color="Color.Primary">Use This Organization's Sign-In</MudButton>
        }
        else if (_initializationFailed)
        {
            <p role="alert">We could not prepare sign-in. Please try again.</p>
            <MudButton OnClick="InitializeSignInAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary">Try Again</MudButton>
        }
        else
        {
            @if (_canReturnToPlatform)
            {
                <MudButton OnClick="RecoverPlatformAsync"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Class="mb-3">Return To Platform</MudButton>
            }
            @if (_changingWorkspace || _selectedWorkspace is null)
            {
                <div class="form-stack">
                    <label for="workspace">Organization Code</label>
                    <input id="workspace"
                           class="form-control"
                           @bind="_workspaceIdentifier"
                           autocomplete="organization" />
                    <p class="auth-provider-note">Use the organization code from your invitation or company sign-in link.</p>
                    @if (!string.IsNullOrWhiteSpace(_message))
                    {
                        <div class="alert alert-danger"
                             role="alert">@_message</div>
                    }
                    <MudButton OnClick="ChooseWorkspaceAsync"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               Disabled="_isBusy">Continue</MudButton>
                    @if (_selectedWorkspace is not null)
                    {
                        <MudButton OnClick="CancelWorkspaceChange"
                                   Disabled="_isBusy">Cancel</MudButton>
                    }
                </div>
            }
            else
            {
                <EditForm FormName="@SignInFormName"
                          Model="FormModel"
                          OnValidSubmit="SignInAsync">
                    <DataAnnotationsValidator />

                    <div class="form-stack">
                        <div>
                            <label for="username">Username or email</label>
                            <InputText id="username"
                                       class="form-control form-control-lg"
                                       @bind-Value="FormModel!.UserName"
                                       autocomplete="username webauthn" />
                            <ValidationMessage For="@(() => FormModel!.UserName)" />
                        </div>

                        <div>
                            <label for="password">Password</label>
                            <InputText id="password"
                                       type="password"
                                       class="form-control form-control-lg"
                                       @bind-Value="FormModel!.Password"
                                       autocomplete="current-password" />
                            <ValidationMessage For="@(() => FormModel!.Password)" />
                        </div>


                        <a class="auth-recovery-link"
                           href="/iam/forgot-password">Forgot password?</a>

                        @if (!string.IsNullOrWhiteSpace(_message))
                        {
                            <div class="alert @(_isError ? "alert-danger" : "alert-success")"
                                 role="alert">@_message</div>
                        }

                        <button class="btn btn-st-primary btn-lg"
                                type="submit"
                                disabled="@_isBusy">@UiLabels.TitleCase(_isBusy ? "Signing in..." : "Sign in")</button>

                        @if (_providerLoadFailed)
                        {
                            <p role="status"
                               class="auth-provider-note">Other sign-in options could not be loaded. You can still use your password or passkey.</p>
                            <MudButton OnClick="LoadProvidersAsync"
                                       Disabled="_isBusy"
                                       Size="Size.Small">Retry Sign-In Options</MudButton>
                        }
                        <div class="auth-separator">
                            <span>Or continue with</span>
                        </div>
                        <div class="auth-providers"
                             aria-label="Other sign-in methods">
                            @foreach (var provider in _ssoProviders)
                            {
                                <button class="auth-provider"
                                        type="button"
                                        disabled="@_isBusy"
                                        @onclick="() => SignInWithProviderAsync(provider.Scheme)">
                                    <MudIcon Icon="@(provider.Scheme == "Google" ? Icons.Custom.Brands.Google : Icons.Custom.Brands.Microsoft)"
                                             Size="Size.Small" />@provider.DisplayName
                                </button>
                            }
                            <button class="auth-provider"
                                    type="button"
                                    @onclick="SignInWithPasskeyAsync"
                                    title="@(_passkeyAvailable ? "Sign In With A Passkey" : "Passkeys are unavailable for this address or browser. Use your password or connected sign-in.")"
                                    disabled="@(_isBusy || !_passkeyAvailable)">
                                <MudIcon Icon="@Icons.Material.Filled.Key"
                                         Size="Size.Small" />Passkey
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
        }
    </div>
</section>
