@using ST.SharedKernel.Features.ControlPlane.Tenants.Dtos
@using ST.SharedKernel.Features.IAM.Users.Dtos
@using Microsoft.AspNetCore.WebUtilities
@inject ST.UI.Blazor.Features.IAM.Users.Implementations.WorkspaceSelection WorkspaceSelection
@inject ST.UI.Blazor.Features.Shared.BackendApi.Contracts.Interfaces.IBackendApiClient Api
@page "/"
@page "/iam/sign-in"
@layout AuthLayout
@rendermode InteractiveServer
@inject IAuthSession AuthSession
@inject NavigationManager Navigation
@inject ILogger<SignIn> Logger
@inject ISnackbar Snackbar
@inject IOptions<BackendApiSettings> BackendApiSettings
@inject ST.UI.Blazor.Features.IAM.Users.Contracts.Interfaces.IAuthService AuthService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage
@inject ITokenStorage Tokens
@implements IAsyncDisposable

<PageTitle>Sign in | StarterTemplate</PageTitle>

<section class="auth-shell">
    <div class="auth-card">
        <div class="auth-heading"><h1>Sign in</h1></div>
        @if (_canReturnToPlatform) { <MudButton OnClick="RecoverPlatformAsync" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-3">Return to platform</MudButton> }
        <EditForm FormName="@SignInFormName" Model="FormModel" OnValidSubmit="SignInAsync">
            <DataAnnotationsValidator />

            <div class="form-stack">
                <div><label for="workspace">Workspace</label><input id="workspace" class="form-control" @bind="_workspaceIdentifier" autocomplete="organization" /></div>
                <div>
                    <label for="username">Username or email</label>
                    <InputText id="username" class="form-control form-control-lg" @bind-Value="FormModel!.UserName" autocomplete="username webauthn" />
                    <ValidationMessage For="@(() => FormModel!.UserName)" />
                </div>

                <div>
                    <label for="password">Password</label>
                    <InputText id="password" type="password" class="form-control form-control-lg" @bind-Value="FormModel!.Password" autocomplete="current-password" />
                    <ValidationMessage For="@(() => FormModel!.Password)" />
                </div>


                <a class="auth-recovery-link" href="/iam/forgot-password">Forgot password?</a>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div class="alert @(_isError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
                }

                <button class="btn btn-st-primary btn-lg" type="submit" disabled="@_isBusy">
                    @(_isBusy ? "Signing in..." : "Sign in")
                </button>

                <div class="auth-separator"><span>Or continue with</span></div>
                <div class="auth-providers" aria-label="Other sign-in methods">
                    @foreach (var provider in _ssoProviders)
                    {
                        <button class="auth-provider" type="button" disabled="@_isBusy"
                                @onclick="() => SignInWithProviderAsync(provider.Scheme)">
                            <MudIcon Icon="@(provider.Scheme == "Google" ? Icons.Custom.Brands.Google : Icons.Custom.Brands.Microsoft)" Size="Size.Small" />@provider.DisplayName
                        </button>
                    }
                    <button class="auth-provider" type="button" @onclick="SignInWithPasskeyAsync" disabled="@_isBusy">
                        <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" />Passkey
                    </button>
                </div>
            </div>
        </EditForm>

    </div>
</section>

@code {
    private const string SignInFormName = "iam-sign-in";

    [SupplyParameterFromForm(FormName = SignInFormName)]
    private SignInFormModel? FormModel { get; set; }

    [SupplyParameterFromQuery(Name = "workspace")] public string? WorkspaceIdentifier { get; set; }
    [SupplyParameterFromQuery(Name = "tenantId")] public Guid? TenantId { get; set; }
    private string _workspaceIdentifier = "";
    private ST.UI.Blazor.Features.IAM.Users.Models.WorkspaceSelectionInfo? _selectedWorkspace;
    private async Task<bool> ResolveWorkspaceAsync(string? identifier = null, Guid? tenantId = null)
    {
        var query = tenantId.HasValue ? $"tenantId={tenantId}" : "identifier=" + Uri.EscapeDataString(identifier ?? "");
        var response = await Api.SendAsync<WorkspaceInfoResponse>(HttpMethod.Get, "api/v1/workspaces/resolve?" + query, requiresAuthentication: false);
        if (!response.IsSuccess || response.Data is null) { _message = UserMessageSanitizer.Normalize(response.Message, "Workspace is not available."); _isError = true; return false; }
        var workspace = response.Data;
        _selectedWorkspace = new(workspace.TenantId, workspace.Identifier, workspace.Name);
        _workspaceIdentifier = workspace.Identifier;
        await WorkspaceSelection.SetAsync(_selectedWorkspace);
        return true;
    }
    private bool _canReturnToPlatform;
    private async Task RecoverPlatformAsync() {
      var backup=await SessionStorage.GetAsync<ST.UI.Blazor.Features.ControlPlane.Demo.PlatformSessionBackup>("workspace.platform");if(!backup.Success || backup.Value is null)return;
      await Tokens.ClearAsync();var current=await Tokens.GetAsync();
      if(string.IsNullOrWhiteSpace(current.AccessToken)) await Tokens.SaveAsync(backup.Value.AccessToken,backup.Value.RefreshToken,backup.Value.SessionId);
      await SessionStorage.DeleteAsync("workspace.platform");Navigation.NavigateTo("/control-panel",forceLoad:true);
    }
    private SsoProviderResponse[] _ssoProviders = [];

    private async Task SignInWithProviderAsync(string scheme)
    {
        if (string.IsNullOrWhiteSpace(BackendApiSettings.Value.PublicBaseUrl) || !await ResolveWorkspaceAsync(_workspaceIdentifier))
        {
            return;
        }

        var path = $"{BackendApiSettings.Value.PublicBaseUrl.TrimEnd('/')}/api/v{BackendApiSettings.Value.Version}/iam/auth/sso/login";
        var url = QueryHelpers.AddQueryString(path, new Dictionary<string, string?>
        {
            ["returnUrl"] = new Uri(new Uri(Navigation.BaseUri), "iam/sso-callback").AbsoluteUri,
            ["tenantId"] = _selectedWorkspace!.TenantId.ToString(),
            ["provider"] = scheme
        });
        Navigation.NavigateTo(url, forceLoad: true);
    }
    private bool _isBusy;
    private bool _isError;
    private string? _message;

    // Passkey Conditional UI state
    private DotNetObjectReference<SignIn>? _dotNetRef;
    private Guid _conditionalCorrelationId;

    protected override void OnInitialized()
    {
        FormModel ??= new();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _canReturnToPlatform=(await SessionStorage.GetAsync<ST.UI.Blazor.Features.ControlPlane.Demo.PlatformSessionBackup>("workspace.platform")).Success;
        _selectedWorkspace = await WorkspaceSelection.GetAsync();
        if ((TenantId.HasValue && _selectedWorkspace?.TenantId != TenantId) || (!string.IsNullOrWhiteSpace(WorkspaceIdentifier) && !string.Equals(_selectedWorkspace?.Identifier, WorkspaceIdentifier, StringComparison.OrdinalIgnoreCase)))
        {
            if (await ResolveWorkspaceAsync(WorkspaceIdentifier, TenantId)) Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            else StateHasChanged();
            return;
        }
        if (!string.IsNullOrWhiteSpace(BackendApiSettings.Value.PublicBaseUrl))
        {
            var providers = await Api.SendAsync<SsoProviderResponse[]>(HttpMethod.Get,
                $"api/v{BackendApiSettings.Value.Version}/iam/auth/sso/providers", requiresAuthentication: false);
            _ssoProviders = providers.Data ?? [];
        }

        await AuthSession.InitializeAsync();
        if (AuthSession.IsAuthenticated)
        {
            Navigation.NavigateTo(AuthSession.MfaEnrollmentRequired ? "/iam/security" : "/dashboard");
            return;
        }

        if (_selectedWorkspace is null)
        {
            if (await ResolveWorkspaceAsync()) Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            else StateHasChanged();
            return;
        }
        _workspaceIdentifier = _selectedWorkspace.Identifier;
        StateHasChanged();
        // Start Conditional UI passkey flow
        await StartConditionalPasskeyAsync();
    }

    private async Task StartConditionalPasskeyAsync()
    {
        try
        {
            // Fire both in parallel: feature-detect (JS/SignalR) and options fetch (HTTP) have zero dependency on each other
            var isSupportedTask = JSRuntime.InvokeAsync<bool>("webauthn.isConditionalMediationAvailable").AsTask();
            var optionsTask = AuthService.RequestPasskeyLoginOptionsAsync(new RequestPasskeyLoginOptionsRequest(null));

            await Task.WhenAll(isSupportedTask, optionsTask);

            if (!await isSupportedTask)
            {
                return;
            }

            var optionsResponse = await optionsTask;
            if (!optionsResponse.IsSuccess || optionsResponse.Data is null)
            {
                return;
            }

            _conditionalCorrelationId = optionsResponse.Data.CorrelationId;
            _dotNetRef ??= DotNetObjectReference.Create(this);

            // Fire-and-forget: JS calls back into OnConditionalAssertionCompleted when the user taps a passkey
            _ = JSRuntime.InvokeVoidAsync(
                "webauthn.startConditionalAssertion",
                optionsResponse.Data.Options.GetRawText(),
                _dotNetRef).AsTask();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start conditional passkey assertion.");
        }
    }

    [JSInvokable]
    public async Task OnConditionalAssertionCompleted(System.Text.Json.JsonElement assertionResponse)
    {
        try
        {
            var request = new ST.SharedKernel.Features.IAM.Users.Dtos.LoginWithPasskeyRequest(
                null,
                _conditionalCorrelationId,
                assertionResponse);

            var response = await AuthSession.SignInWithPasskeyAsync(request);
            if (!response.IsSuccess || response.Data is null)
            {
                await InvokeAsync(() =>
                {
                    _isError = true;
                    _message = GetDisplayMessage(response.Message, "Passkey sign-in failed. Please try again.");
                    Snackbar.Add(_message, Severity.Error);
                    StateHasChanged();
                });
                return;
            }

            await InvokeAsync(() =>
            {
                Navigation.NavigateTo(AuthSession.MfaEnrollmentRequired ? "/iam/security" : "/dashboard");
            });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error completing conditional passkey sign-in.");
        }
    }

    private async Task SignInAsync()
    {
        _isBusy = true;
        _message = null;
        _isError = false;

        try
        {
            if (!await ResolveWorkspaceAsync(_workspaceIdentifier)) return;
            var form = FormModel ??= new();
            var request = new PasswordLoginRequest(form.UserName, form.Password, form.RememberMe, form.ReturnUrl, "blazor-server");
            var response = await AuthSession.SignInAsync(request);

            if (!response.IsSuccess || response.Data is null)
            {
                _isError = true;
                _message = GetDisplayMessage(response.Message, "We could not sign you in. Please check your username and password.");
                Snackbar.Add(_message, Severity.Error);
                return;
            }

            if (response.Data.Requires2FA)
            {
                Navigation.NavigateTo($"/iam/verify-2fa?userId={Uri.EscapeDataString(response.Data.UserId)}");
                return;
            }

            if (!AuthSession.IsAuthenticated)
            {
                _isError = true;
                _message = GetDisplayMessage(
                    AuthSession.LastError,
                    "Sign in succeeded, but we could not load your profile. Please confirm the API is running and try again.");
                Snackbar.Add(_message, Severity.Warning);
                return;
            }

            Navigation.NavigateTo(AuthSession.MfaEnrollmentRequired ? "/iam/security" : "/dashboard");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while signing in.");
            _isError = true;
            _message = "Something went wrong while signing you in. Please try again. If this continues, check the UI logs for the sign-in error.";
            Snackbar.Add(_message, Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string GetDisplayMessage(string? message, string fallback)
    {
        if (string.IsNullOrWhiteSpace(message)
            || string.Equals(message, "Operation Successful", StringComparison.OrdinalIgnoreCase))
        {
            return fallback;
        }

        return UserMessageSanitizer.Normalize(message, fallback);
    }

    private async Task SignInWithPasskeyAsync()
    {
        if (!await ResolveWorkspaceAsync(_workspaceIdentifier)) return;
        _isBusy = true;
        _message = null;
        _isError = false;

        // Cancel any ongoing conditional UI flow
        try { await JSRuntime.InvokeVoidAsync("webauthn.cancelConditionalAssertion"); }
        catch { /* ignore */ }

        try
        {
            var form = FormModel ??= new();
            var optionsResponse = await AuthService.RequestPasskeyLoginOptionsAsync(
                new RequestPasskeyLoginOptionsRequest(string.IsNullOrWhiteSpace(form.UserName) ? null : form.UserName));

            if (!optionsResponse.IsSuccess || optionsResponse.Data is null)
            {
                _isError = true;
                _message = GetDisplayMessage(optionsResponse.Message, "Could not start passkey login.");
                Snackbar.Add(_message, Severity.Error);
                return;
            }

            var correlationId = optionsResponse.Data.CorrelationId;
            var assertionJson = await JSRuntime.InvokeAsync<string>(
                "webauthn.startExplicitAssertion",
                optionsResponse.Data.Options.GetRawText());

            var assertion = System.Text.Json.JsonDocument.Parse(assertionJson).RootElement;

            var request = new ST.SharedKernel.Features.IAM.Users.Dtos.LoginWithPasskeyRequest(
                string.IsNullOrWhiteSpace(form.UserName) ? null : form.UserName,
                correlationId,
                assertion);
            var response = await AuthSession.SignInWithPasskeyAsync(request);

            if (!response.IsSuccess || response.Data is null)
            {
                _isError = true;
                _message = GetDisplayMessage(response.Message, "We could not sign you in with your passkey.");
                Snackbar.Add(_message, Severity.Error);
                return;
            }

            if (response.Data.Requires2FA)
            {
                Navigation.NavigateTo($"/iam/verify-2fa?userId={Uri.EscapeDataString(response.Data.UserId)}");
                return;
            }

            if (!AuthSession.IsAuthenticated)
            {
                _isError = true;
                _message = GetDisplayMessage(
                    AuthSession.LastError,
                    "Sign in succeeded, but we could not load your profile. Please confirm the API is running and try again.");
                Snackbar.Add(_message, Severity.Warning);
                return;
            }

            Navigation.NavigateTo(AuthSession.MfaEnrollmentRequired ? "/iam/security" : "/dashboard");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error while signing in with passkey.");
            _isError = true;
            _message = "Passkey sign-in was cancelled or failed.";
            Snackbar.Add(_message, Severity.Error);

            // Restart conditional UI for the next attempt
            _ = StartConditionalPasskeyAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("webauthn.cancelConditionalAssertion");
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { /* circuit torn down */ }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cancelling conditional passkey on dispose.");
        }

        _dotNetRef?.Dispose();
    }
}
