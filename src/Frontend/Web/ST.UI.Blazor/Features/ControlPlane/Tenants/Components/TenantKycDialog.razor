<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2">Confirm that the workspace review is complete and enter its case or evidence reference.</MudText>
        <MudTextField @bind-Value="_reference" Label="Evidence reference" MaxLength="256"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Approve"
                   Disabled="@string.IsNullOrWhiteSpace(_reference)">Approve KYC</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    private string _reference = string.Empty;

    private void Approve()
    {
        Dialog.Close(DialogResult.Ok(_reference.Trim()));
    }

    private void Cancel()
    {
        Dialog.Cancel();
    }
}
