# Copy to .env only when configuring the platform manually.
# scripts/setup-local-platform.ps1 creates an ignored .env with random local-only values.
RABBITMQ_USER=replace-local-user
RABBITMQ_PASSWORD=replace-local-password
REDIS_PASSWORD=replace-local-password
REDIS_HOST_PORT=6382
MSSQL_SA_PASSWORD=replace-local-strong-password
AZURITE_ACCOUNT_NAME=stdevstorage
AZURITE_ACCOUNT_KEY=replace-local-base64-storage-key
APP_API_HOST_PORT=8180
APP_BLAZOR_HOST_PORT=8181
APP_GOOGLE_SSO_ENABLED=false
APP_GOOGLE_SSO_CLIENT_ID=
APP_GOOGLE_SSO_CLIENT_SECRET=
APP_ENTRA_SSO_ENABLED=false
APP_ENTRA_SSO_TENANT_ID=
APP_ENTRA_SSO_CLIENT_ID=
APP_ENTRA_SSO_CLIENT_SECRET=
APP_JWT_SECRET=replace-local-strong-jwt-secret
APP_IAM_TEMPORARY_PASSWORD=replace-local-temporary-password
APP_SQL_CONNECTION_STRING=Server=host.docker.internal;Database=ST;User Id=sa;Password=replace-local-sql-password;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=True
SEQ_PASSWORD=replace-local-strong-seq-password
